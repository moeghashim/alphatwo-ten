# Platform Postgres (Render auto-injects in prod)
DATABASE_URL=postgres://user:pass@localhost:5432/tenwhy_alpha

# Sapiom Compute (Blaxel microVM sandboxes)
SAPIOM_API_KEY=sap_xxx

# GitHub owner (user or org) + tokens
GITHUB_TOKEN=ghp_xxx                # PAT used by orchestrator (repo scope)
GIT_PUSH_TOKEN=ghp_xxx              # PAT injected into sandbox for `git push` (repo only)
GITHUB_OWNER=moeghashim
GITHUB_TEMPLATE_REPO=tenwhy-generated-app-template

# Coding agent selection
# Primary
CODING_AGENT=cursor                 # cursor | claude | codex | gemini
CODING_MODEL=composer-2.5

# Fallback (set FALLBACK_AGENT empty to disable)
FALLBACK_AGENT=gemini
FALLBACK_MODEL=gemini-3.5-flash

# Per-agent secrets — only required for the agents you use
CURSOR_API_KEY=crsr_xxx             # required if cursor is primary or fallback
ANTHROPIC_API_KEY=sk-ant-xxx        # required if claude is primary or fallback
OPENAI_API_KEY=sk-xxx               # required if codex is primary or fallback
GEMINI_API_KEY=AIza_xxx             # required if gemini is primary or fallback (default fallback)

# Render API
RENDER_API_KEY=rnd_xxx
RENDER_OWNER_ID=tea_xxx
RENDER_REGION=oregon
RENDER_PLAN=starter

# Public URLs
PLATFORM_BASE_URL=https://alpha.tenwhy.com
API_BASE_URL=https://api.alpha.tenwhy.com
DATA_API_BASE_URL=https://data.alpha.tenwhy.com

# Timeouts (ms)
AGENT_TIMEOUT_MS=900000             # 15 min per agent attempt
BUILD_TIMEOUT_MS=300000             # 5 min for npm ci && npm run build
DEPLOY_POLL_MS=12000                # poll Render every 12 s
JOB_TIMEOUT_MS=1800000              # 30 min hard cap per job

# Tenant limits (data-api)
MAX_DOCS_PER_APP=10000
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_SEC=50
